/**
 * @file .env.example
 * @description Environment variables template for backend configuration
 * @tags configuration, environment
 */

# ============================================
# Server Configuration
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# Database Configuration
# ============================================
# MongoDB connection URL
DB_URL=mongodb://localhost:27017/affnet

# ============================================
# Authentication & Security
# ============================================
# JWT secret for token generation (use a strong, random value)
JWT_ADMIN_PASSWORD=your-super-secret-jwt-key-change-this-in-production-with-a-strong-key

# ============================================
# Cloudinary Configuration (Image Upload)
# ============================================
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# ============================================
# Email Configuration (Optional)
# ============================================
# For email notifications (SendGrid, Gmail SMTP, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ============================================
# Optional: External Services
# ============================================
# AWS S3 Configuration
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_S3_BUCKET=your-bucket-name

# Payment Gateway (Razorpay, Stripe, etc.)
# RAZORPAY_KEY_ID=your-key
# RAZORPAY_KEY_SECRET=your-secret

